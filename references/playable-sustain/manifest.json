    "b3": "references/audio/jrhodes-neighbors-a886e6c/A_059__B3_{1..5}.wav"
  },
  "engine_protocol": "render --note N --velocity V --sample-rate 44100 --seconds 8 --hold 7.5 --pickup 3 --sustain calibrated for N in 50/55/59 and V in 1.0/0.6/0.25 against layers 1/3/5; compare-tone from 0 s; compare-partials 0.5..4.5 s with 512 ms windows. One G3 render at velocity 0.6 keeps the default pickup.",
